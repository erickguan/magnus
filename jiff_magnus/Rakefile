# frozen_string_literal: true

require "rake"
require "rake/clean"
require "rbconfig"
require "rubygems/package"
require "tmpdir"

ROOT = File.expand_path(__dir__)
SPEC = Gem::Specification.load(File.join(ROOT, "jiff-magnus.gemspec"))
PACKAGE = File.join(ROOT, "pkg", "#{SPEC.full_name}.gem")
NATIVE_LIBRARY = File.join(ROOT, "jiff_magnus.#{RbConfig::CONFIG.fetch('DLEXT')}")

CLOBBER.include(File.join(ROOT, "pkg"),
                NATIVE_LIBRARY, File.join(ROOT, "Makefile"), File.join(ROOT, "mkmf.log"))

desc "Build the native extension against the local Magnus checkout"
task :compile do
  Dir.chdir(ROOT) do
    ruby "extconf.rb"
    sh RbConfig::CONFIG.fetch("MAKE", "make")
  end
end

desc "Test the local native extension in Ruby"
task test: :compile do
  Dir.mktmpdir("magnus-timezone-test-") do |library|
    native = File.join(library, "jiff_magnus")
    FileUtils.mkdir_p(native)
    FileUtils.cp(File.join(ROOT, "lib", "jiff_magnus.rb"), library)
    FileUtils.cp(NATIVE_LIBRARY, native)
    sh({"RUBYLIB" => library}, RbConfig.ruby, File.join(ROOT, "test", "timezone_test.rb"))
  end
end

desc "Build a source gem (installation requires a published Magnus version)"
task :build do
  FileUtils.mkdir_p(File.dirname(PACKAGE))
  Dir.mktmpdir("magnus-timezone-package-") do |stage|
    SPEC.files.each do |file|
      destination = File.join(stage, file)
      FileUtils.mkdir_p(File.dirname(destination))
      FileUtils.cp(File.join(ROOT, file), destination)
    end
    # Keep local paths in the checkout; distributed gems resolve the declared
    # Magnus version from the registry. No Git source or extra manifest needed.
    manifest = File.join(stage, "Cargo.toml")
    File.write(manifest, File.read(manifest).gsub(', path = ".."', ""))
    Dir.chdir(stage) { Gem::Package.build(SPEC, false, false, PACKAGE) }
  end
end

desc "Install and test the source gem after its Magnus dependency is published"
task installed: :build do
  ruby File.join(ROOT, "test", "installed_gem_test.rb"), PACKAGE
end

desc "Test the core timezone ABI between independent Rust and C extensions"
task :interop do
  ruby File.expand_path("../tests/timezone_abi/run.rb", ROOT)
end

task default: :test
